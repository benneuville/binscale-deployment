apiVersion: kafka.strimzi.io/v1beta2
kind: KafkaTopic
metadata:
  name: {{ topic_name }}
  labels:
    strimzi.io/cluster: my-cluster
spec:
  partitions: {{ partitions }}
  replicas: 1
  config:
    retention.ms: 14400000
    segment.bytes: 1073741824
    min.insync.replicas: 1
    message.timestamp.type: CreateTime